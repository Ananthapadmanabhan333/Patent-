# PatentIQ Environment Configuration
# Copy this file to .env and fill in your values

# --- API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_PATENTS_API_KEY=your_google_patents_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# --- JWT Security ---
SECRET_KEY=supersecret-jwt-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://patentiq:patentiq_pass@localhost:5432/patentiq_db
SYNC_DATABASE_URL=postgresql://patentiq:patentiq_pass@localhost:5432/patentiq_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App Config ---
APP_NAME=PatentIQ
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File Storage ---
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
FAISS_INDEX_PATH=./data/faiss_index
